# FRIDAY AI — Git Ignore Rules

# Build directory (generated by CMake)
build/

# User data (personal notes, etc.)
data/

# Personal configuration (NEVER commit secrets)
config/config.txt

# IDE settings (VS Code)
.vscode/

# Compiled files
*.exe
*.o
*.obj

# OS junk files
Thumbs.db
.DS_Store

# Temporary files
*.tmp
*.bak